[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Cleaning up package cache...
Depends = coreutils
When = PostTransaction
# 00-base.sh relocates the package cache to /usr/lib/sysimage and repoints
# CacheDir at it, so the original /var/cache/pacman/pkg no longer exists
Exec = /usr/bin/rm -rf /usr/lib/sysimage/cache/pacman/pkg