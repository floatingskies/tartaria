[Unit]
Description=Subsystem For %u
RequiresMountsFor=%t/containers
RequiresMountsFor=/run/user/%U
ConditionKernelCommandLine=!rd.live.image
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=all
KillSignal=SIGTERM
KillMode=mixed
ExecStart=/usr/lib/subsystem/daemon/subsystem-containerd
Restart=always
RestartSec=2

[Install]
# started on demand by "synergy shell", not at login
WantedBy=default.target
