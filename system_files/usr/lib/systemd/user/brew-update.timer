#
# The upstream timer is a system timer driving a service that hardcodes uid
# 1000; this one is a user timer, so it runs as whoever is logged in.

[Unit]
Description=Timer for the Homebrew update service
Wants=network-online.target
After=network-online.target

[Timer]
OnBootSec=10min
OnUnitInactiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
