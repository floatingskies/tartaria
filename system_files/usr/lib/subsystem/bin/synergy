#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only

# set errexit & pipefail
set -eo pipefail

# do our checks
if [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
elif [[ ! -f /run/.containerenv ]]; then
	echo "[!!!] Running outside of a subsystem."
	exit 64
fi

# utilities
help() {
    cat <<EOF
usage:
    synergy [options...] <command>

synopsis:
    execute, link, or unlink commands from the host system

options:
    -h, --help                      show this help message
    -H, --host                      return to a login shell on the host system
    -r, --root                      execute <command> as root, requires user authentication
    -l, --link                      link a command from the host
    -u, --unlink                    unlink a command linked from the host

unrecognized options will be treated as a string to execute on the host within a seperate bash shell, e.g. "echo foo"
EOF
}

# resolve the login shell of this user, as configured on the host
login_shell() {
    local shell

    shell=$(getent passwd "$USER" 2>/dev/null | cut -d: -f7)
    if [[ -n "$shell" && "$shell" != /usr/sbin/nologin && "$shell" != /bin/false ]]; then
        printf '%s' "$shell"
    else
        printf '%s' /usr/bin/fish
    fi
}

# run a string on the host inside a dedicated bash shell
host_shell() {
    /usr/libexec/host-spawn /usr/bin/bash -c "$*"
}

# iterate through args
case $1 in
    -h|--help)
        # help msg
        help
        ;;
    -H|--host)
        # shift args
        shift

        # return to a host login shell, or run the provided command there
        if [[ -z "$*" ]]; then
            /usr/libexec/host-spawn "$(login_shell)" -l
        else
            host_shell "$@"
        fi
        ;;
    -r|--root)
        # shift args
        shift

        # check if a command was provided
        if [[ -z "$*" ]]; then
            help
            echo "[!!!] No command provided."
            exit 1
        fi

        # execute cmd as root
        /usr/libexec/host-spawn pkexec /usr/bin/bash -c "$*"
        ;;
    -l|--link)
        # shift args
        shift

        # run checks
        if [[ -z "$1" ]]; then
            echo "[!!!] No command to link provided."
            help
            exit 1
        elif ! /usr/libexec/host-spawn which "$1" >/dev/null 2>&1; then
            echo "[!!!] Command $1 not found on the host."
            exit 1
        elif [[ -e /usr/bin/"$1" || -e /usr/local/bin/"$1" ]]; then
            if [[ "$(readlink -f "/usr/bin/$1" 2>/dev/null || true)" == "/usr/libexec/host-spawn" ]] \
                || [[ "$(readlink -f "/usr/local/bin/$1" 2>/dev/null || true)" == "/usr/libexec/host-spawn" ]]; then
                echo "[!!!] Command $1 is already linked."
            else
                echo "[!!!] Command $1 already exists."
            fi
            exit 1
        fi

        # link command
        echo "[1/1] Linking command $1..."
        sudo ln -sT /usr/libexec/host-spawn /usr/local/bin/"$1"
        echo "[1/1] Linked command $1 to /usr/local/bin/$1"
        ;;
    -u|--unlink)
        # shift args
        shift

        # run checks
        if [[ -z "$1" ]]; then
            echo "[!!!] No command to unlink provided."
            help
            exit 1
        elif [[ ! -e /usr/local/bin/"$1" ]] \
            || [[ "$(readlink -f "/usr/local/bin/$1" 2>/dev/null || true)" != "/usr/libexec/host-spawn" ]]; then
            echo "[!!!] Command $1 isn't linked."
            exit 1
        fi

        # unlink command
        echo "[1/1] Unlinking command $1..."
        sudo rm -f /usr/local/bin/"$1"
        echo "[1/1] Unlinked command $1"
        ;;
    *)
        # run checks
        if [[ -z "$*" ]]; then
            echo "[!!!] No command provided."
            help
            exit 1
        fi

        # execute cmd normally
        host_shell "$@"
        ;;
esac
