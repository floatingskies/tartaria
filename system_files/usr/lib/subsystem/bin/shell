#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
#
# Enter the mutable subsystem. Runs on the host, drops the user into a fish
# shell inside their subsystem container.

## set constants
CTERM=${1:-${TERM:-xterm-256color}}
SUBSYS_ID=$(printf '%s%s' "$(</etc/machine-id)" "$USER" | sha256sum | awk '{print $1}')
readonly CTERM
readonly SUBSYS_ID

## logging
NORM=$(tput sgr0 2>/dev/null || true)
GRAY=$(tput setaf 7 2>/dev/null || true)
RED=$(tput setaf 1 2>/dev/null || true)
readonly NORM GRAY RED

## utilities
unit_state() {
    systemctl --user is-active subsystem-containerd.service 2>/dev/null || true
}

fallback() {
    local reason="$1"

    clear
    cat <<EOF
${RED}Oops,

Your subsystem is unavailable: ${reason}
Logs containing relevant information can be viewed with the following command:${NORM}

${GRAY}journalctl --user -xeu subsystem-containerd${NORM}

${RED}Falling back to a non-login host shell (${HOST_FALLBACK:-bash})...${NORM}

EOF

    exec "$HOST_FALLBACK"
}

enter() {
    local -i attempt=0

    while (( attempt < 3 )); do
        if podman exec -u "$(id -u)" -e "TERM=$CTERM" -it "subsystem-$SUBSYS_ID" /bin/fish; then
            exit 0
        fi
        (( attempt++ ))
    done

    fallback "the subsystem container refused the session"
}

throbber() {
    local frame
    local -a frames=(/ - \\ \|)

    for frame in "${frames[@]}"; do
        printf '\r[%s] Waiting for your subsystem...' "$frame"
        sleep 0.25
    done
    printf '\r\033[K'
}

# wait for a subsystem that is in the middle of starting or stopping, the
# resulting state is handed back in SETTLED so the throbber keeps the terminal
settled_state=""
await_settled() {
    local -i second
    local state="$1"

    for (( second = 0; second < 20; second++ )); do
        state=$(unit_state)
        [[ "$state" == "active" || "$state" == "failed" || "$state" == "inactive" ]] && break
        throbber
    done

    settled_state="$state"
}

## do our checks
if [[ "$EUID" == "0" ]] || [[ "$EUID" -lt "1000" ]]; then
    echo "[!!!] Please do not run this as an administrator or system user."
    exit 77
fi

## the shell to fall back to when the subsystem is unavailable
fallback_shell() {
    local candidate

    for candidate in "${SHELL:-}" /usr/bin/fish /usr/bin/bash; do
        if [[ -x "$candidate" ]]; then
            printf '%s' "$candidate"
            return
        fi
    done

    printf '%s' /bin/sh
}
HOST_FALLBACK=$(fallback_shell)
readonly HOST_FALLBACK

## main logic
STATE=$(unit_state)

if [[ "$STATE" == "active" ]]; then
    enter
elif [[ "$STATE" == "activating" || "$STATE" == "deactivating" || "$STATE" == "reloading" ]]; then
    # wait for the subsystem to settle, throbber included
    await_settled "$STATE"
    STATE="$settled_state"

    if [[ "$STATE" == "active" ]]; then
        enter
    else
        fallback "the subsystem did not finish starting (state: ${STATE:-unknown})"
    fi
else
    fallback "the subsystem is not running (state: ${STATE:-unknown})"
fi
