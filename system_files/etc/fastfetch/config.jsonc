{
  // SPDX-License-Identifier: GPL-3.0-only
  //
  // System-wide fastfetch configuration for Tartaria.
  //
  // This is the *lowest* priority configuration: fastfetch loads the first
  // configuration file it finds, so a config in ~/.config/fastfetch/config.jsonc
  // takes precedence and replaces this file entirely.
  //
  // Generate your own with: fastfetch --gen-config-force
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/usr/share/tartaria/ascii-logo/logo.txt"
  },

  "modules": [
    "title",

    { "type": "os", "key": "OS", "format": "{name}" },
    { "type": "os", "key": "Edition", "format": "{variant}" },
    "kernel",
    "uptime",
    "shell",
    "terminal",
    { "type": "terminalsize", "key": "Resolution", "format": "{width}x{height}" },
    "wm",
    "theme",
    "icons",
    "terminalfont",

    "break",

    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",

    "break",

    "locale",
    { "type": "publicip", "format": "{ip}" }
  ]
}
