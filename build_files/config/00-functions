retry() {
    local attempt=1
    local cmd=("$@")

    until "${cmd[@]}"; do
        if (( attempt >= 3 )); then
            echo "Command failed after ${attempt} attempts." >&2
            return 1
        fi
        echo "Attempt ${attempt} failed, retrying." >&2
        sleep $(( attempt * 2 ))
        (( attempt++ ))
    done
}

# kernel_version
#
# echo the module tree of the recorded kernel, e.g. "6.12.8.arch1-1" or
# "7.2.7-bore"; the tree name is not always the package version, so it is
# looked up in the package file list rather than derived from it
kernel_version() {
    local recorded=""

    if [[ -r /usr/lib/tartaria/kernel-info ]]; then
        # shellcheck source=/dev/null
        source /usr/lib/tartaria/kernel-info
        recorded="${KERNEL_VERSION:-}"
    fi

    if [[ -n "$recorded" && -d "/usr/lib/modules/$recorded" ]]; then
        printf '%s\n' "$recorded"
        return 0
    fi

    # fall back to the newest module tree that is actually on disk
    find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
        | sed 's|/usr/lib/modules/||' | sort -V | tail -n 1
}

# record_kernel <package>...
#
# remember the kernel that was installed, so that later build stages don't
# have to guess which of possibly several module trees is the right one
record_kernel() {
    local package="" resolved="" kver=""

    for package in "$@"; do
        if pacman -Q "$package" >/dev/null 2>&1; then
            resolved="$package"
            break
        fi
    done

    if [[ -z "$resolved" ]]; then
        echo "[!!!] None of the kernel packages ($*) is installed, the module tree will have to be guessed." >&2
        return 0
    fi

    while read -r kver; do
        [[ -n "$kver" && -d "/usr/lib/modules/$kver" ]] && break
        kver=""
    done < <(pacman -Ql "$resolved" 2>/dev/null | sed -n 's|^/usr/lib/modules/\([^/]*\)/.*|\1|p' | sort -u)

    if [[ -z "$kver" ]]; then
        echo "[!!!] Could not work out the module tree of $resolved, the module tree will have to be guessed." >&2
        return 0
    fi

    install -d /usr/lib/tartaria
    cat <<EOF >/usr/lib/tartaria/kernel-info
# generated by 01-packages.sh, consumed by 05-modsign.sh and 06-finalize.sh
KERNEL_PACKAGE="$resolved"
KERNEL_VERSION="$kver"
KERNEL_HEADERS="${resolved}-headers"
EOF
}

# set_os_release <name> <variant>
#
# rewrite the host identity without mangling upstream URLs, e.g. the privacy
# policy link, which a global `s/Arch/Tartaria/` rewrite would destroy
set_os_release() {
    local name="$1" variant="$2"
    local file="/usr/lib/os-release"

    sed -i \
        -e "s|^NAME=.*|NAME=\"$name\"|" \
        -e "s|^PRETTY_NAME=.*|PRETTY_NAME=\"$name ($variant)\"|" \
        "$file"

    grep -q '^VARIANT=' "$file" || echo "VARIANT=\"$variant\"" >>"$file"
    grep -q '^VARIANT_ID=' "$file" || echo "VARIANT_ID=\"$variant\"" >>"$file"
}
